#!/bin/sh

set -u

# Initial host-toolchain compilation is setup cost. Warm the same workspace,
# targets, and feature set that Check will measure; a source/build failure is
# still a failed Release Obligation rather than a latency result.
if ! cargo test --workspace --all-targets --all-features --no-run >/dev/null; then
    echo "Failed: the Regression Case build failed during Check setup."
    exit 1
fi
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings >/dev/null; then
    echo "Failed: the static-validation build failed during Check setup."
    exit 1
fi

check_started="$(perl -MTime::HiRes=time -e 'printf "%.9f", time')" || {
    echo "Unable: Perl Time::HiRes is required to measure Check latency."
    exit 2
}

if ! cargo fmt --all --check; then
    echo "Failed: formatting is not canonical."
    exit 1
fi

if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo "Failed: static validation failed."
    exit 1
fi

if ! cargo test --workspace --all-targets --all-features; then
    echo "Failed: a Regression Case failed."
    exit 1
fi

check_elapsed="$(perl -MTime::HiRes=time -e 'printf "%.3f", time - $ARGV[0]' "$check_started")" || {
    echo "Unable: Check latency could not be measured."
    exit 2
}

reference_host=false
if command -v sysctl >/dev/null 2>&1; then
    host_model="$(sysctl -n hw.model 2>/dev/null || true)"
    host_memory="$(sysctl -n hw.memsize 2>/dev/null || true)"
    if [ "$host_model" = "Mac16,12" ] && [ "$host_memory" = "17179869184" ]; then
        reference_host=true
    fi
fi

if ! perl -e 'exit !($ARGV[0] < 2.0)' "$check_elapsed"; then
    if [ "$reference_host" = true ]; then
        echo "Failed: warm Check latency was ${check_elapsed}s on the Reference Development Host; the hard ceiling is 2.000s."
        exit 1
    fi
    echo "Warning: warm Check latency was ${check_elapsed}s; the 2.000s ceiling is authoritative only on the Reference Development Host."
fi

echo "Passed (${check_elapsed}s)."
